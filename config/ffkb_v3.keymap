/* upstream bindings and behaviors */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
 
/* layer definitions */
#define BASE 0
#define NAVI 1
#define NUMB 2
#define FUNC 3
#define MOUS 4
#define SCRL 5
#define SYST 6

/* local overlays */
#include "behaviors.dtsi"
#include "combos.dtsi"

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2>;
        triggers-per-rotation = <15>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
    &trans          &kp Q           &kp W           &kp F           &kp P           &kp B           &kp J           &kp L           &kp U           &kp Y           &kp SQT         &trans
    &trans          &hml LGUI A     &hml LALT R     &hml LCTL S     &hml LSHIFT T   &kp G           &kp M           &hmr RSHIFT N   &hmr RCTRL E    &hmr RALT I     &hmr RGUI O     &trans
    &trans          &ltm MOUS Z     &kp X           &kp C           &ltm MOUS D     &kp V           &kp K           &ltm MOUS H     &mm_csemi       &mm_dcoln       &ltm MOUS FSLH  &trans
                    &trans                          &ltm SCRL BSPC  &sft_caps       &num_fun        &lt NAVI ENTER  &kp SPACE       &trans                          &trans
            >;
        };

        navi_layer {
            bindings = <
    &trans          &gresc          &kp HOME        &kp UP          &kp END         &kp PG_UP       &kp K_APP       &swap_next      &swap_prev      &none           &blconfirm      &trans
    &trans          &kp LC(A)       &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_DN       &kp C_VOL_UP    &kp RSHIFT      &kp RCTRL       &kp RALT        &kp RGUI        &trans
    &trans          &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(Y)       &kp C_VOL_DN    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp BSLH        &trans
                    &trans                          &kp DEL         &kp TAB         &trans          &trans          &trans          &trans                          &trans
            >;
        };

        numb_layer {
            bindings = <
    &trans          &blconfirm      &none           &none           &none           &none           &kp EQUAL       &kp N7          &kp N8          &kp N9          &kp DOT         &trans
    &trans          &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &none           &kp PLUS        &kp N4          &kp N5          &kp N6          &kp ASTRK       &trans
    &trans          &none           &none           &none           &none           &none           &kp MINUS       &kp N1          &kp N2          &kp N3          &kp FSLH        &trans
                    &trans                          &trans          &trans          &trans          &mo NAVI        &kp N0          &trans                          &trans
            >;
        };

        func_layer {
            bindings = <
    &trans          &none           &none           &none           &none           &none           &none           &kp F7          &kp F8          &kp F9          &kp F12         &trans
    &trans          &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &none           &none           &kp F4          &kp F5          &kp F6          &kp F11         &trans
    &trans          &none           &none           &none           &none           &none           &none           &kp F1          &kp F2          &kp F3          &kp F10         &trans
                    &trans                          &trans          &trans          &trans          &trans          &trans          &trans                          &trans
            >;
        };

        mouse_layer {
            bindings = <
    &trans          &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &trans
    &trans          &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &none           &none           &kp RSHIFT      &kp RCTRL       &kp RALT        &kp RGUI        &trans
    &trans          &trans          &none           &none           &none           &none           &none           &none           &none           &none           &trans          &trans
                    &trans                          &mkp MB2        &mkp MB1        &mkp MB3        &none           &none           &trans                          &trans
            >;
        };

        scrl_layer {
            bindings = <
    &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
    &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
    &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                    &trans                          &trans          &trans          &trans          &trans          &trans          &trans                          &trans
            >;
        };

        syst_layer {
            bindings = <
    &trans          &bootloader     &sys_reset      &none           &none           &out OUT_BLE    &out OUT_USB    &none           &none           &sys_reset      &bootloader     &trans
    &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &none           &none           &bt BT_CLR      &none           &none           &none           &trans
    &trans          &bt BT_DISC 0   &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &none           &none           &none           &none           &none           &none           &trans
                    &trans                          &trans          &trans          &trans          &trans          &trans          &trans                          &trans
            >;
        };
    };
};
